# Configuração do Banco de Dados MySQL
# Substitua os valores abaixo pelas suas próprias configurações.

# URL de conexão com o seu banco de dados.
# O 'reservasdb' é o nome do banco de dados que você precisa criar.
spring.datasource.url=jdbc:mysql://localhost:3306/reservasdb

# Seu nome de usuário do MySQL (geralmente 'root').
spring.datasource.username=root

# Sua senha do MySQL.
spring.datasource.password=sua_senha_aqui

# Configurações do Hibernate
# 'update' tentará atualizar o schema do banco de dados automaticamente.
# 'create' irá apagar e recriar o schema toda vez que a aplicação iniciar. Use com cuidado.
spring.jpa.hibernate.ddl-auto=update

# Mostra as queries SQL geradas pelo Hibernate no console. Útil para debug.
spring.jpa.show-sql=true
